generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  username  String?  @unique  // Set on first visit to Messages
  password  String?          // Nullable: Google OAuth users won't have a password initially
  googleId  String?  @unique // Google OAuth "sub" ID — used to link accounts
  image     String?  // Profile picture URL
  role      String   @default("student") // student, teacher, parent, admin
  points    Int      @default(0)
  bio       String?
  skills    String?  // JSON string: [{name: "Python", level: 80}]
  
  // Student specific
  learningGoal  String?
  degree        String? // B.Tech, B.Sc, BCA, MBA, etc.
  specialization String? // CSE, Mechanical, etc.
  studyHours    Float   @default(0)
  currentStreak Int     @default(0)
  longestStreak Int     @default(0)
  lastActiveAt  DateTime @default(now())

  // Teacher specific
  expertise       String?
  experienceYears Int?
  qualification   String?
  rating          Float   @default(5.0)

  // Parent specific
  parentNotes     String?

  // Privacy
  isProfilePublic     Boolean @default(true)
  hideFromLeaderboard Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Institution logic
  institutionId String?
  institution   Institution? @relation("InstitutionMembers", fields: [institutionId], references: [id])
  
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  ownedInstitution Institution? @relation("InstitutionAdmin")
  
  joinRequests  JoinRequest[]
  leaveRequests LeaveRequest[]
  courseLeaveRequests CourseLeaveRequest[]

  // Relations
  courses     Course[]     @relation("TeacherCourses")
  enrollments Enrollment[]
  enrollmentHistory EnrollmentHistory[]
  messages    Message[]
  marks       Marks[]
  attendances Attendance[]
  certificates Certificate[]
  completedLessons LessonCompletion[]
  assignmentSubmissions AssignmentSubmission[]
  announcements Announcement[]

  // Parent-child relationships
  children  User[]  @relation("ParentChild")
  parents   User[]  @relation("ParentChild")

  // Private Messaging
  sentMessages     PrivateMessage[] @relation("SentMessages")
  receivedMessages PrivateMessage[] @relation("ReceivedMessages")

  // Chat Requests
  sentChatRequests     ChatRequest[]  @relation("SentChatRequests")
  receivedChatRequests ChatRequest[]  @relation("ReceivedChatRequests")

  // Notifications
  notifications Notification[]

  // Group Chat
  createdGroups  GroupChat[]     @relation("GroupCreator")
  groupMembers   GroupMember[]
  groupMessages  GroupMessage[]  @relation("GroupMessageSender")

  // Q&A
  questions Question[] @relation("QuestionAuthor")
  answers   Answer[]   @relation("AnswerAuthor")

  // Feedback
  feedbacks Feedback[]

  // Promotion Requests
  promotionRequests PromotionRequest[]
  
  // Blog
  posts Post[]

  // Classroom
  classMaterials       ClassMaterial[]      @relation("ClassMaterialAuthor")
  classQuestions       ClassQuestion[]      @relation("ClassQuestionAuthor")
  classQuestionReplies ClassQuestionReply[] @relation("ClassQuestionReplyAuthor")
  coTeachingCourses    Course[]             @relation("CoTeachers")
  quizSubmissions      QuizSubmission[]
}

model Certificate {
  id        String   @id @default(cuid())
  title     String
  issueDate DateTime @default(now())
  url       String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Institution {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  adminId   String? @unique
  admin     User?   @relation("InstitutionAdmin", fields: [adminId], references: [id])

  members       User[]        @relation("InstitutionMembers")
  departments   Department[]
  joinRequests  JoinRequest[]
  leaveRequests LeaveRequest[]
  announcements Announcement[]
}

model Department {
  id            String      @id @default(cuid())
  name          String
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  courses       Course[]
  members       User[]
}

model JoinRequest {
  id            String      @id @default(cuid())
  userId        String
  institutionId String
  status        String      @default("pending") // pending, approved, rejected
  createdAt     DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionId])
}

model LeaveRequest {
  id            String      @id @default(cuid())
  userId        String
  institutionId String
  status        String      @default("pending") // pending, approved, rejected
  createdAt     DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionId])
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String
  details     String?
  subject     String
  thumbnail   String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacherId   String
  teacher     User         @relation("TeacherCourses", fields: [teacherId], references: [id])
  
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  enrollments  Enrollment[]
  enrollmentHistory EnrollmentHistory[]
  messages     Message[]
  modules      Module[]
  leaveRequests CourseLeaveRequest[]
  assignments  Assignment[]
  announcements Announcement[]

  // Classroom-specific
  classCode   String?  @unique
  section     String?
  room        String?
  topics       ClassTopic[]
  materials    ClassMaterial[]
  questions    ClassQuestion[]
  coTeachers   User[]       @relation("CoTeachers")
  events       ClassEvent[]
  subjects     ClassSubject[]
}

model Module {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(0)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id        String   @id @default(cuid())
  title     String
  content   String?  // Text content
  videoUrl  String?
  fileUrl   String?  // PDF, PPT, etc.
  fileType  String?  // 'pdf', 'ppt', etc.
  order     Int      @default(0)
  moduleId  String
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]
}

model LessonCompletion {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Enrollment {
  id         String   @id @default(cuid())
  userId     String
  courseId   String
  status     String   @default("active")
  progress   Int      @default(0)
  enrolledAt DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model EnrollmentHistory {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model CourseLeaveRequest {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  status    String   @default("pending") // pending, approved, rejected
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Message {
  id        String   @id @default(cuid())
  text      String
  courseId  String
  senderId  String
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model PrivateMessage {
  id          String   @id @default(cuid())
  text        String
  senderId    String
  receiverId  String
  createdAt   DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Marks {
  id        String   @id @default(cuid())
  studentId String
  subject   String
  score     Float
  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime @default(now())
  present   Boolean  @default(true)

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model ChatRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  status     String   @default("pending") // pending, accepted, rejected
  createdAt  DateTime @default(now())

  sender   User @relation("SentChatRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedChatRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // chat_request, chat_accepted, new_message
  title     String
  body      String
  read      Boolean  @default(false)
  linkUrl   String?
  fromId    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GroupChat {
  id          String   @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime @default(now())

  createdBy User          @relation("GroupCreator", fields: [createdById], references: [id])
  members   GroupMember[]
  messages  GroupMessage[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("member") // admin, member
  status   String   @default("pending") // pending, accepted, rejected
  joinedAt DateTime @default(now())

  group GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model GroupMessage {
  id        String   @id @default(cuid())
  text      String
  groupId   String
  senderId  String
  createdAt DateTime @default(now())

  group  GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User     @relation("GroupMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
}

model Question {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User     @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  answers Answer[]
}

model Answer {
  id         String   @id @default(cuid())
  content    String
  authorId   String
  questionId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  author   User     @relation("AnswerAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  content   String
  type      String   @default("suggestion") // bug, suggestion, other
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PromotionRequest {
  id        String   @id @default(cuid())
  userId    String   @unique
  reason    String
  status    String   @default("pending") // pending, approved, rejected
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String
  dueDate     DateTime
  courseId    String
  createdAt   DateTime @default(now())

  // Classroom-specific fields
  topicId     String?
  subjectId   String?
  fileUrl     String?
  points      Int      @default(100)

  topic       ClassTopic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subject     ClassSubject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String    @id @default(cuid())
  assignmentId String
  studentId    String
  fileUrl      String?
  content      String?
  grade        Float?
  feedback     String?
  status       String    @default("assigned")
  turnedInAt   DateTime?
  returnedAt   DateTime?
  createdAt    DateTime  @default(now())

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Announcement {
  id            String   @id @default(cuid())
  title         String
  content       String
  authorId      String
  institutionId String?
  courseId      String?
  subjectId     String?
  createdAt     DateTime @default(now())

  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  institution Institution?  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  course      Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject     ClassSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  coverImage  String?
  category    String
  tags        String // SQLite doesn't support arrays, we will store a JSON string
  readTime    Int
  featured    Boolean  @default(false)
  publishedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("unread")
  createdAt DateTime @default(now())
}

// ── Classroom Models ────────────────────────────────────────────────────────

model ClassSubject {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#C9A96E")
  order       Int      @default(0)
  courseId    String
  createdAt   DateTime @default(now())

  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics        ClassTopic[]
  assignments   Assignment[]
  materials     ClassMaterial[]
  questions     ClassQuestion[]
  announcements Announcement[]
  events        ClassEvent[]
  quizzes       ClassQuiz[]
}

model ClassTopic {
  id        String   @id @default(cuid())
  title     String
  order     Int      @default(0)
  courseId  String
  subjectId String?
  createdAt DateTime @default(now())

  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject     ClassSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  assignments Assignment[]
  materials   ClassMaterial[]
  quizzes     ClassQuiz[]
}

model ClassMaterial {
  id          String   @id @default(cuid())
  title       String
  description String?
  fileUrl     String?
  linkUrl     String?
  topicId     String?
  subjectId   String?
  courseId    String
  authorId    String
  createdAt   DateTime @default(now())

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic    ClassTopic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subject  ClassSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  author   User          @relation("ClassMaterialAuthor", fields: [authorId], references: [id], onDelete: Cascade)
}

model ClassQuestion {
  id        String   @id @default(cuid())
  question  String
  courseId  String
  authorId  String
  topicId   String?
  subjectId String?
  createdAt DateTime @default(now())

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author   User           @relation("ClassQuestionAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subject  ClassSubject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  replies  ClassQuestionReply[]
}

model ClassQuestionReply {
  id         String   @id @default(cuid())
  content    String
  questionId String
  authorId   String
  createdAt  DateTime @default(now())

  question ClassQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User          @relation("ClassQuestionReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
}

model ClassEvent {
  id          String   @id @default(cuid())
  courseId    String
  subjectId   String?
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  location    String?
  createdAt   DateTime @default(now())

  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject  ClassSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

model ClassQuiz {
  id               String    @id @default(cuid())
  title            String
  description      String?
  dueDate          DateTime?
  timeLimitMinutes Int?
  topicId          String?
  subjectId        String?
  courseId         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  topic       ClassTopic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subject     ClassSubject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  questions   QuizQuestion[]
  submissions QuizSubmission[]
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  questionText  String
  type          String @default("multiple_choice")
  points        Int    @default(1)
  options       String?
  correctAnswer String?
  order         Int    @default(0)

  quiz    ClassQuiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]
}

model QuizSubmission {
  id          String   @id @default(cuid())
  quizId      String
  userId      String
  status      String   @default("submitted")
  score       Int?
  submittedAt DateTime @default(now())

  quiz    ClassQuiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([quizId, userId])
}

model QuizAnswer {
  id            String   @id @default(cuid())
  submissionId  String
  questionId    String
  answerText    String
  isCorrect     Boolean?
  pointsAwarded Int?

  submission QuizSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   QuizQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
}
